# VPS Guardian Agent Configuration
API_TOKEN=change-me-use-openssl-rand-hex-32
JWT_SECRET=change-me-use-openssl-rand-hex-32
HOST=0.0.0.0
PORT=8443

# TLS (opcional - recomendado para produção)
# SSL_CERTFILE=/etc/vps-guardian/certs/cert.pem
# SSL_KEYFILE=/etc/vps-guardian/certs/key.pem

# Limites de alerta
CPU_ALERT_THRESHOLD=90
RAM_ALERT_THRESHOLD=90
DISK_ALERT_THRESHOLD=90
TEMP_ALERT_THRESHOLD=80

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
MAX_FAILED_ATTEMPTS=5
BLACKLIST_DURATION_MINUTES=30
